{
  "name": "lifestack",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lifestack/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @lifestack/db generate",
    "db:migrate": "pnpm --filter @lifestack/db migrate",
    "check:privacy": "bash scripts/check-privacy.sh --all",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:seed": "pnpm --filter @lifestack/db seed"
  }
}
