# Local development: copy to .env (gitignored). In production set these in the Vercel
# project's environment variables instead. Never commit real values.

# Postgres connection string. Locally this is the Compose database (pnpm db:up).
# In production use your provider's pooled connection string.
DATABASE_URL=postgres://lifestack:lifestack@127.0.0.1:5432/lifestack

# The single owner password for the web UI. Use a long random passphrase.
APP_PASSWORD=

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Display timezone for the app (IANA name).
APP_TZ=UTC
