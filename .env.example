# Copy to .env and fill in. .env is gitignored; never commit real values.

POSTGRES_USER=lifestack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifestack

# Used by apps on the host (pnpm dev, migrations). Containers get their own URL from Compose.
DATABASE_URL=postgres://lifestack:change-me@127.0.0.1:5432/lifestack

# Address the web and mcp ports bind to. Set to the host's Tailscale IP (tailscale ip -4)
# in production so nothing listens on a public interface.
BIND_ADDR=127.0.0.1

# Display timezone for the app (IANA name).
APP_TZ=UTC
