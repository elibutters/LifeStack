// Shared build settings. Anything personal (your Apple team, your own bundle id) goes in
// Local.xcconfig, which is gitignored. See README.md.
APP_BUNDLE_ID = com.example.lifestack
// Your deployment, kept in Local.xcconfig so the app never asks for it. Empty means the sign-in screen asks.
API_BASE_URL =
#include? "Local.xcconfig"
