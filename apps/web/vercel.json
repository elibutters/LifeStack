{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then pnpm --filter @lifestack/db migrate; fi && next build",
  "crons": [
    {
      "path": "/api/cron/outlook",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/plaid",
      "schedule": "30 10 * * *"
    }
  ]
}
